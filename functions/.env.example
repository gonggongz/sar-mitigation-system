# Salin file ini jadi "functions/.env" lalu isi API key Gemini
# dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Token rahasia untuk whatsappWebhook. Buat string acak panjang, misalnya:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# lalu pasang di URL WhatAuto: https://.../whatsappWebhook?token=<token-ini>
WEBHOOK_TOKEN=
